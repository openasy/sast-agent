{
  "name": "@openasy/sast-agent",
  "version": "0.6.0",
  "private": true,
  "description": "OpenAsy SAST agent: clones repositories sast gives it into memory, scans them with Opengrep and sends back what it finds. sast holds no code.",
  "license": "AGPL-3.0-only",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/openasy/sast-agent.git"
  },
  "scripts": {
    "start": "node agent/main.ts",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:rules": "opengrep test rules"
  },
  "prettier": "@openasy/code-style/prettier",
  "engines": {
    "node": ">=26.12.0",
    "npm": ">=11"
  },
  "devDependencies": {
    "@openasy/code-style": "https://github.com/openasy/code-style/releases/download/v0.1.2/openasy-code-style-0.1.2.tgz",
    "@types/node": "^26.6.5",
    "oxlint": "1.87.0",
    "prettier": "3.9.9",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
